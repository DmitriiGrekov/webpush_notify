# Django настройки для локальной разработки
DEBUG=True
SECRET_KEY=django-insecure-local-dev-key-change-in-production-12345678901234567890
ALLOWED_HOSTS=localhost,127.0.0.1

# База данных (не требуется для локальной разработки - используется SQLite)
# Если хотите использовать PostgreSQL локально, раскомментируйте:
# POSTGRES_HOST=localhost
# POSTGRES_DB=pushsite
# POSTGRES_USER=pushsite_user
# POSTGRES_PASSWORD=your-local-password
# POSTGRES_PORT=5432

# VAPID ключи для push уведомлений
# Сгенерируйте их с помощью: python generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=private_key.pem
VAPID_ADMIN_EMAIL=admin@localhost
TELEGRAM_BOT_TOKEN=bot_token